# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=bigquery-public-data.thelook_ecommerce

# LLM Models Configuration (LiteLLM format, e.g., openrouter/google/gemini-2.5-flash-lite)
SQL_MODEL=openrouter/google/gemini-2.5-flash-lite
ROUTER_MODEL=openrouter/google/gemini-2.5-flash-lite
FORECAST_MODEL=openrouter/google/gemini-2.5-flash-lite
SYNTHESIS_MODEL=openrouter/google/gemini-2.5-flash-lite

# Safety Guardrails & Limits
MAX_SQL_RETRIES=3
MAX_ROWS_RETURNED=500

# API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here (optional if using OpenAI models)

# Observability (Arize Phoenix)
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# MongoDB Session Persistence
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=genai_agent

# Google Database MCP Toolbox URL
TOOLBOX_URL=http://127.0.0.1:5000
